<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.SpecialSecuritySupportController"
            style="-fx-background-color:#f4f6f9;">

    <Label layoutX="220.0"
           layoutY="25.0"
           text="Special Security Support"
           style="-fx-font-size:28px; -fx-font-weight:bold;" />

    <Label layoutX="80.0"
           layoutY="100.0"
           text="Support Type"/>

    <ComboBox fx:id="cmbSupportType"
              layoutX="240.0"
              layoutY="95.0"
              prefWidth="350.0"/>

    <Label layoutX="80.0"
           layoutY="170.0"
           text="Details"/>

    <TextArea fx:id="txtDetails"
              layoutX="240.0"
              layoutY="165.0"
              prefWidth="500.0"
              prefHeight="180.0"/>

    <Button layoutX="250.0"
            layoutY="430.0"
            prefWidth="150.0"
            text="Submit"
            onAction="#submitRequest"/>

    <Button layoutX="500.0"
            layoutY="430.0"
            prefWidth="150.0"
            text="Back"
            onAction="#back"/>

</AnchorPane>