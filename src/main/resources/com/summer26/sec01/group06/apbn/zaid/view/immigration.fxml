<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="900.0" prefWidth="1200.0" style="-fx-background-color:#F4F6F8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.sec01.group06.apbn.zaid.controllers.ImmigrationController">

   <children>

      <!-- ================= HEADER ================= -->

      <HBox prefHeight="70.0" prefWidth="1200.0" style="-fx-background-color:#0A2E5C;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

         <children>

            <Label prefHeight="35.0" prefWidth="398.0" text="✈ APBN Airport Security System" textFill="WHITE">

               <font>
                  <Font name="System Bold" size="24" />
               </font>

            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="dashboardLabel" text="Immigration Officer Dashboard" textFill="WHITE">

               <font>
                  <Font name="System Bold" size="20" />
               </font>

            </Label>

         </children>

      </HBox>

      <!-- ================= TITLE ================= -->

      <Label layoutX="451.0" layoutY="82.0" text="IMMIGRATION OFFICER" textFill="#0A2E5C">

         <font>
            <Font name="System Bold" size="30" />
         </font>

      </Label>

      <Label layoutX="489.0" layoutY="134.0" text="Select an operation to continue" textFill="#555555">

         <font>
            <Font size="16" />
         </font>

      </Label>

      <VBox alignment="CENTER" layoutX="439.0" layoutY="207.0" spacing="15">

         <children>

            <Button fx:id="passengerVerificationButton" onAction="#openPassengerVerification" prefHeight="52" prefWidth="350" style="-fx-background-color:#0A2E5C;                                        -fx-background-radius:12;                                        -fx-text-fill:white;                                        -fx-font-size:16;                                        -fx-font-weight:bold;                                        -fx-cursor:hand;" text="🛂 Passenger Verification" />

            <Button fx:id="documentVerificationButton" onAction="#openDocumentVerification" prefHeight="52" prefWidth="350" style="-fx-background-color:#0A2E5C;                                        -fx-background-radius:12;                                        -fx-text-fill:white;                                        -fx-font-size:16;                                        -fx-font-weight:bold;                                        -fx-cursor:hand;" text="📄 Document Verification" />

            <Button fx:id="approvalButton" onAction="#openApproval" prefHeight="52" prefWidth="350" style="-fx-background-color:#0A2E5C;                                        -fx-background-radius:12;                                        -fx-text-fill:white;                                        -fx-font-size:16;                                        -fx-font-weight:bold;                                        -fx-cursor:hand;" text="✅ Approve Entry / Exit" />

            <Button fx:id="rejectPassengerButton" onAction="#openRejectPassenger" prefHeight="52" prefWidth="350" style="-fx-background-color:#0A2E5C;                                        -fx-background-radius:12;                                        -fx-text-fill:white;                                        -fx-font-size:16;                                        -fx-font-weight:bold;                                        -fx-cursor:hand;" text="❌ Reject Passenger" />

            <Button fx:id="travelHistoryButton" onAction="#openTravelHistory" prefHeight="52" prefWidth="350" style="-fx-background-color:#0A2E5C;                                        -fx-background-radius:12;                                        -fx-text-fill:white;                                        -fx-font-size:16;                                        -fx-font-weight:bold;                                        -fx-cursor:hand;" text="🌍 Travel History" />

            <Button fx:id="reportsButton" onAction="#openReports" prefHeight="52" prefWidth="350" style="-fx-background-color:#0A2E5C;                                        -fx-background-radius:12;                                        -fx-text-fill:white;                                        -fx-font-size:16;                                        -fx-font-weight:bold;                                        -fx-cursor:hand;" text="📊 Immigration Reports" />

            <Button fx:id="flaggedPassengersButton" onAction="#openFlaggedPassengers" prefHeight="52" prefWidth="350" style="-fx-background-color:#0A2E5C;                                        -fx-background-radius:12;                                        -fx-text-fill:white;                                        -fx-font-size:16;                                        -fx-font-weight:bold;                                        -fx-cursor:hand;" text="🚨 Flagged Passengers" />

            <Button fx:id="checkpointButton" onAction="#openCheckpointManagement" prefHeight="52" prefWidth="350" style="-fx-background-color:#0A2E5C;                                        -fx-background-radius:12;                                        -fx-text-fill:white;                                        -fx-font-size:16;                                        -fx-font-weight:bold;                                        -fx-cursor:hand;" text="🏢 Checkpoint Management" />

         </children>

      </VBox>
      <Button fx:id="logoutButton"
              layoutX="574.0"
              layoutY="794.0"
              mnemonicParsing="false"
              onAction="#logout"
              prefHeight="40.0"
              prefWidth="120.0"
              style="-fx-background-color:#C62828;
               -fx-text-fill:white;
               -fx-background-radius:12;
               -fx-font-weight:bold;
               -fx-cursor:hand;"
              text="LOGOUT">

         <font>
            <Font name="System Bold" size="15.0"/>
         </font>

      </Button>

   </children>

</AnchorPane>
