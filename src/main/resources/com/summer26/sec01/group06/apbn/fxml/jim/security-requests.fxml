<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.jim.SecurityRequestsController">

    <top>

        <Label text="SECURITY REQUESTS"
               BorderPane.alignment="CENTER"
               style="-fx-background-color:#2E7D32;
                      -fx-text-fill:white;
                      -fx-font-size:24;
                      -fx-font-weight:bold;
                      -fx-padding:18;
                      -fx-max-width:Infinity;
                      -fx-alignment:center;"/>

    </top>

    <center>

        <VBox alignment="CENTER"
              spacing="15">

            <padding>
                <Insets top="25"/>
            </padding>

            <ListView fx:id="listRequests"
                      prefWidth="700"
                      prefHeight="280"/>

            <TextField fx:id="txtPassengerId"
                       promptText="Passenger ID"
                       prefWidth="300"/>

            <TextArea fx:id="txtProblem"
                      promptText="Problem Description"
                      prefWidth="450"
                      prefHeight="100"/>

            <HBox alignment="CENTER"
                  spacing="12">

                <Button text="Assign Team"
                        onAction="#assignTeam"/>

                <Button text="Mark Completed"
                        onAction="#completeRequest"/>

                <Button text="Delete"
                        onAction="#deleteRequest"/>

            </HBox>

            <HBox alignment="CENTER"
                  spacing="12">

                <Button text="Refresh"
                        onAction="#loadRequests"/>

                <Button text="Back"
                        onAction="#goBack"
                        style="-fx-background-color:red;
                               -fx-text-fill:white;
                               -fx-font-weight:bold;"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>