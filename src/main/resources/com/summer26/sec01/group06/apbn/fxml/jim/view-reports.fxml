<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.jim.ViewReportsController">

    <top>

        <Label text="SYSTEM REPORTS"
               BorderPane.alignment="CENTER"
               style="-fx-background-color:#2E7D32;
                      -fx-text-fill:white;
                      -fx-font-size:24px;
                      -fx-font-weight:bold;
                      -fx-padding:18;
                      -fx-max-width:Infinity;
                      -fx-alignment:center;"/>

    </top>

    <center>

        <VBox alignment="CENTER"
              spacing="18">

            <padding>
                <Insets top="35"
                        bottom="35"
                        left="35"
                        right="35"/>
            </padding>

            <Button text="Security Requests"
                    prefWidth="320"
                    prefHeight="42"
                    onAction="#openSecurityRequests"/>

            <Button text="Special Security Support"
                    prefWidth="320"
                    prefHeight="42"
                    onAction="#openSpecialSupports"/>

            <Button text="Lost Property Reports"
                    prefWidth="320"
                    prefHeight="42"
                    onAction="#openLostProperties"/>

            <Button text="Restricted Item Reports"
                    prefWidth="320"
                    prefHeight="42"
                    onAction="#openRestrictedReports"/>

            <Button text="Blacklist Management"
                    prefWidth="320"
                    prefHeight="42"
                    onAction="#openBlacklist"/>

            <Button fx:id="btnBack"
                    text="Back"
                    prefWidth="180"
                    prefHeight="42"
                    onAction="#goBack"
                    style="-fx-background-color:#d32f2f;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;"/>

        </VBox>

    </center>

</BorderPane>