<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0"
            prefWidth="700.0"
            style="-fx-background-color:#f4f8fb;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.shan.ViewOfficersController">

    <children>

        <Button fx:id="btnBack"
                layoutX="20"
                layoutY="20"
                prefWidth="90"
                prefHeight="35"
                text="⬅ Back"
                onAction="#goBack"
                style="-fx-background-color:#dc3545;
                       -fx-text-fill:white;
                       -fx-font-weight:bold;" />

        <Label layoutX="210"
               layoutY="25"
               text="Security Officers"
               textFill="#15417d">

            <font>
                <Font size="28"/>
            </font>

        </Label>

        <TableView fx:id="tableOfficers"
                   layoutX="25"
                   layoutY="80"
                   prefWidth="650"
                   prefHeight="380">

            <columns>

                <TableColumn fx:id="colOfficerId"
                             text="Officer ID"
                             prefWidth="130"/>

                <TableColumn fx:id="colName"
                             text="Name"
                             prefWidth="200"/>

                <TableColumn fx:id="colShift"
                             text="Shift"
                             prefWidth="150"/>

                <TableColumn fx:id="colStatus"
                             text="Status"
                             prefWidth="170"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>