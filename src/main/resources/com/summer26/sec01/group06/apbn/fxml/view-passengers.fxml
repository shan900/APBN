<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0"
            prefWidth="850.0"
            style="-fx-background-color: #f4f8fb;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.ViewPassengersController">

    <children>

        <!-- Back Button -->
        <Button fx:id="btnBack"
                layoutX="20.0"
                layoutY="20.0"
                prefHeight="35.0"
                prefWidth="90.0"
                text="⬅ Back"
                onAction="#goBack"
                style="-fx-background-color:#dc3545;
                       -fx-text-fill:white;
                       -fx-font-size:14px;
                       -fx-font-weight:bold;
                       -fx-background-radius:8;" />

        <!-- Title -->
        <Label layoutX="250.0"
               layoutY="20.0"
               text="All Passengers"
               textFill="#15417d">

            <font>
                <Font name="System Bold" size="26.0"/>
            </font>

        </Label>

        <!-- Passenger Table -->
        <TableView fx:id="tablePassengers"
                   layoutX="20.0"
                   layoutY="80.0"
                   prefHeight="390.0"
                   prefWidth="810.0"
                   style="-fx-font-size:13px;">

            <columns>

                <TableColumn fx:id="colPassengerId"
                             prefWidth="110.0"
                             text="Passenger ID"/>

                <TableColumn fx:id="colName"
                             prefWidth="160.0"
                             text="Name"/>

                <TableColumn fx:id="colPassport"
                             prefWidth="150.0"
                             text="Passport"/>

                <TableColumn fx:id="colNationality"
                             prefWidth="140.0"
                             text="Nationality"/>

                <TableColumn fx:id="colFlight"
                             prefWidth="100.0"
                             text="Flight"/>

                <TableColumn fx:id="colGate"
                             prefWidth="80.0"
                             text="Gate"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>