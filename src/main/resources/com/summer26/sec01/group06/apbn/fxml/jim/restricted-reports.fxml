<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.jim.RestrictedReportsController">

    <top>

        <Label text="RESTRICTED ITEM REPORTS"
               BorderPane.alignment="CENTER"
               style="-fx-background-color:#EF6C00;
                      -fx-text-fill:white;
                      -fx-font-size:24;
                      -fx-font-weight:bold;
                      -fx-padding:18;
                      -fx-max-width:Infinity;
                      -fx-alignment:center;"/>

    </top>

    <center>

        <VBox alignment="CENTER"
              spacing="15">

            <padding>
                <Insets top="25"/>
            </padding>

            <ListView fx:id="listReports"
                      prefWidth="700"
                      prefHeight="220"/>

            <TextField fx:id="txtPassengerId"
                       promptText="Passenger ID"
                       prefWidth="300"/>

            <TextField fx:id="txtItem"
                       promptText="Restricted Item"
                       prefWidth="300"/>

            <TextArea fx:id="txtReason"
                      promptText="Reason"
                      prefWidth="450"
                      prefHeight="100"/>

            <HBox alignment="CENTER"
                  spacing="10">

                <Button text="Search"
                        onAction="#searchReport"/>

                <Button text="Investigate"
                        onAction="#investigateReport"/>

                <Button text="Delete"
                        onAction="#deleteReport"/>

            </HBox>

            <HBox alignment="CENTER"
                  spacing="10">

                <Button text="Refresh"
                        onAction="#loadReports"/>

                <Button text="Back"
                        onAction="#goBack"
                        style="-fx-background-color:red;
                               -fx-text-fill:white;
                               -fx-font-weight:bold;"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>