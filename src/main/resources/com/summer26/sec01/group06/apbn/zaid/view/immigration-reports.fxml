<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color:#F4F6F8;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.sec01.group06.apbn.zaid.controllers.ImmigrationReportsController">

   <children>

      <!-- ================= HEADER ================= -->

      <HBox prefHeight="55.0" prefWidth="1200.0" style="-fx-background-color:#0A2E5C;" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

         <children>

            <Button fx:id="backButton" onAction="#backButton" prefHeight="35" prefWidth="90" style="-fx-background-color:#1E4E8C;                                -fx-background-radius:18;                                -fx-text-fill:white;                                -fx-font-weight:bold;" text="← Back" />

            <Label text="✈ APBN Airport Security System" textFill="WHITE">

               <font>
                  <Font size="22" />
               </font>

            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <Label text="Immigration Reports" textFill="WHITE">

               <font>
                  <Font size="18" />
               </font>

            </Label>

         </children>

      </HBox>

      <!-- ================= TITLE ================= -->

      <Label layoutX="400" layoutY="90" text="IMMIGRATION REPORT GENERATION">

         <font>
            <Font size="26" />
         </font>

      </Label>

      <!-- ================= FORM ================= -->

      <Label layoutX="120" layoutY="180" text="Report Type" />

      <ComboBox fx:id="reportTypeComboBox" layoutX="250" layoutY="175" prefWidth="240" />

      <Label layoutX="120" layoutY="250" text="From Date" />

      <DatePicker fx:id="fromDatePicker" layoutX="250" layoutY="245" />

      <Label layoutX="620" layoutY="250" text="To Date" />

      <DatePicker fx:id="toDatePicker" layoutX="720" layoutY="245" />

      <!-- ================= REPORT PREVIEW ================= -->

      <Label layoutX="120" layoutY="330" text="Report Preview" />

      <TextArea fx:id="reportPreviewArea" layoutX="250" layoutY="320" prefHeight="180" prefWidth="700" />

      <!-- ================= BUTTONS ================= -->

      <HBox layoutX="343.0" layoutY="531.0" spacing="20">

         <children>

            <Button fx:id="generateButton" onAction="#generateReport" prefWidth="150" style="-fx-background-color:#2E7D32;                                -fx-text-fill:white;                                -fx-font-weight:bold;" text="Generate" />

            <Button fx:id="saveButton" onAction="#saveReport" prefWidth="150" style="-fx-background-color:#1565C0;                                -fx-text-fill:white;                                -fx-font-weight:bold;" text="Save" />

            <Button fx:id="exportButton" onAction="#exportPDF" prefWidth="150" style="-fx-background-color:#EF6C00;                                -fx-text-fill:white;                                -fx-font-weight:bold;" text="Export PDF" />



         </children>

      </HBox>

      <!-- ================= STATUS ================= -->

      <Label fx:id="statusLabel" layoutX="577.0" layoutY="655.0" style="-fx-font-size:16;                       -fx-font-weight:bold;                       -fx-text-fill:#0A2E5C;" />

   </children>

</AnchorPane>
