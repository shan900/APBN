<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0"
            prefWidth="750.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.shan.SupervisorViewPassengerController">

    <children>

        <Button fx:id="btnBack"
                layoutX="20.0"
                layoutY="20.0"
                prefWidth="90.0"
                text="⬅ Back"
                onAction="#goBack"
                style="-fx-background-color:red; -fx-text-fill:white; -fx-font-weight:bold;" />

        <Label layoutX="200.0"
               layoutY="25.0"
               text="View All Passenger"
               textFill="#15417d">

            <font>
                <Font name="System Bold" size="26.0"/>
            </font>

        </Label>

        <Label layoutX="60.0"
               layoutY="120.0"
               text="Passenger ID :">

            <font>
                <Font size="16.0"/>
            </font>

        </Label>

        <TextField fx:id="txtPassengerId"
                   layoutX="190.0"
                   layoutY="115.0"
                   prefWidth="220.0"
                   promptText="Enter Passenger ID"/>

        <Button layoutX="450.0"
                layoutY="114.0"
                prefWidth="110.0"
                prefHeight="30.0"
                text="Search"
                onAction="#searchPassenger"
                style="-fx-background-color:#4CAF50; -fx-text-fill:white; -fx-font-weight:bold;"/>

        <Button layoutX="580.0"
                layoutY="114.0"
                prefWidth="90.0"
                prefHeight="30.0"
                text="Clear"
                onAction="#clearData"
                style="-fx-background-color:#2196F3; -fx-text-fill:white; -fx-font-weight:bold;"/>

        <Label layoutX="60.0"
               layoutY="190.0"
               text="Passenger Details :">

            <font>
                <Font size="16.0"/>
            </font>

        </Label>

        <Label fx:id="lblResult"
               layoutX="190.0"
               layoutY="190.0"
               prefWidth="500.0"
               prefHeight="220.0"
               wrapText="true"
               text="Passenger information will appear here."/>

    </children>

</AnchorPane>