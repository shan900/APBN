<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color:#f4f6f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.sec01.group06.apbn.controller.jim.EmergencyNotificationsController">

    <Label layoutX="230.0" layoutY="25.0" style="-fx-font-size:28px; -fx-font-weight:bold;" text="Emergency Notifications" />

    <Label layoutX="70.0" layoutY="90.0" style="-fx-font-size:18px; -fx-font-weight:bold;" text="Current Notifications" />

    <Label fx:id="lblNotification" layoutX="70.0" layoutY="130.0" prefHeight="220.0" prefWidth="700.0" style="-fx-font-size:16px;" />

    <Button layoutX="250.0" layoutY="430.0" onAction="#refreshNotifications" prefWidth="150.0" text="Refresh" />

    <Button layoutX="500.0" layoutY="430.0" onAction="#back" prefWidth="150.0" style="-fx-background-color: red; -fx-text-fill: white; -fx-font-weight: bold;" text="Back" />

</AnchorPane>
