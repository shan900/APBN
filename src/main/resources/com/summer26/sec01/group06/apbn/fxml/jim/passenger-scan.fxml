<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.jim.PassengerScanController"
            prefWidth="900.0"
            prefHeight="650.0">

   <children>

      <Button fx:id="btnBack"
              layoutX="40.0"
              layoutY="35.0"
              prefWidth="90.0"
              text="⬅ Back"
              onAction="#goBack"
              style="-fx-background-color:red; -fx-text-fill:white; -fx-font-weight:bold;"/>

      <Label layoutX="300.0"
             layoutY="35.0"
             text="Passenger Scan">

         <font>
            <Font size="30"/>
         </font>

      </Label>

      <Label layoutX="60.0"
             layoutY="120.0"
             text="Passenger ID"/>

      <TextField fx:id="txtPassengerId"
                 layoutX="180.0"
                 layoutY="115.0"
                 prefWidth="220.0"/>

      <Label layoutX="60.0"
             layoutY="180.0"
             text="Name"/>

      <TextField fx:id="txtName"
                 layoutX="180.0"
                 layoutY="175.0"
                 prefWidth="220.0"/>

      <Label layoutX="60.0"
             layoutY="240.0"
             text="Passport"/>

      <TextField fx:id="txtPassport"
                 layoutX="180.0"
                 layoutY="235.0"
                 prefWidth="220.0"/>

      <Label layoutX="60.0"
             layoutY="300.0"
             text="Nationality"/>

      <TextField fx:id="txtNationality"
                 layoutX="180.0"
                 layoutY="295.0"
                 prefWidth="220.0"/>

      <Label layoutX="470.0"
             layoutY="120.0"
             text="Flight No"/>

      <TextField fx:id="txtFlightNo"
                 layoutX="600.0"
                 layoutY="115.0"
                 prefWidth="220.0"/>

      <Label layoutX="470.0"
             layoutY="180.0"
             text="Gate"/>

      <TextField fx:id="txtGate"
                 layoutX="600.0"
                 layoutY="175.0"
                 prefWidth="220.0"/>

      <Button fx:id="btnScan"
              layoutX="330.0"
              layoutY="390.0"
              prefWidth="180.0"
              prefHeight="40.0"
              text="Verify Passenger"
              onAction="#scanPassenger"
              style="-fx-background-color:#4CAF50; -fx-text-fill:white; -fx-font-weight:bold;"/>

      <Button layoutX="530.0"
              layoutY="390.0"
              prefWidth="120.0"
              text="Clear"
              onAction="#clearFields"/>

      <Label fx:id="lblResult"
             layoutX="180.0"
             layoutY="470.0"
             prefWidth="520.0"
             alignment="CENTER"
             text=""
             style="-fx-font-size:18px; -fx-font-weight:bold;"/>

   </children>

</AnchorPane>