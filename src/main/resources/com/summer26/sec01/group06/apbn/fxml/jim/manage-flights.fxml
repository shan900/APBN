<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.jim.ManageFlightsController">

    <top>

        <Label text="MANAGE FLIGHTS"
               BorderPane.alignment="CENTER"
               style="-fx-background-color:#2E7D32;
                      -fx-text-fill:white;
                      -fx-font-size:24px;
                      -fx-font-weight:bold;
                      -fx-padding:18;
                      -fx-max-width:Infinity;
                      -fx-alignment:center;"/>

    </top>

    <center>

        <VBox alignment="CENTER" spacing="18">

            <padding>
                <Insets top="30" bottom="30" left="30" right="30"/>
            </padding>

            <!-- Search -->

            <HBox alignment="CENTER" spacing="10">

                <TextField fx:id="txtFlightNo"
                           prefWidth="220"
                           promptText="Flight Number"/>

                <Button fx:id="btnSearch"
                        text="Search"
                        prefWidth="100"
                        onAction="#searchFlight"/>

            </HBox>

            <!-- Destination -->

            <TextField fx:id="txtDestination"
                       prefWidth="320"
                       promptText="Destination"/>

            <!-- Departure Time -->

            <TextField fx:id="txtDepartureTime"
                       prefWidth="320"
                       promptText="Departure Time"/>

            <!-- Gate -->

            <TextField fx:id="txtGate"
                       prefWidth="320"
                       promptText="Gate"/>

            <!-- Status -->

            <ComboBox fx:id="cmbStatus"
                      prefWidth="320"
                      promptText="Flight Status"/>

            <!-- CRUD -->

            <HBox alignment="CENTER" spacing="15">

                <Button fx:id="btnAdd"
                        text="Add"
                        prefWidth="90"
                        onAction="#addFlight"/>

                <Button fx:id="btnUpdate"
                        text="Update"
                        prefWidth="90"
                        onAction="#updateFlight"/>

                <Button fx:id="btnDelete"
                        text="Delete"
                        prefWidth="90"
                        onAction="#deleteFlight"/>

            </HBox>

            <HBox alignment="CENTER" spacing="15">

                <Button fx:id="btnClear"
                        text="Clear"
                        prefWidth="90"
                        onAction="#clearData"/>

                <Button fx:id="btnBack"
                        text="Back"
                        prefWidth="90"
                        onAction="#goBack"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>