<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.jim.SecurityClearanceStatusController"
            style="-fx-background-color:#f4f6f9;">

    <Label layoutX="220.0"
           layoutY="35.0"
           text="Security Clearance Status"
           style="-fx-font-size:28px; -fx-font-weight:bold;" />

    <Label layoutX="100.0"
           layoutY="180.0"
           text="Current Status:"
           style="-fx-font-size:18px;"/>

    <Label fx:id="lblStatus"
           layoutX="270.0"
           layoutY="180.0"
           style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:green;"/>

    <Button layoutX="250.0"
            layoutY="420.0"
            prefWidth="150.0"
            text="Refresh"
            onAction="#refreshStatus"/>

    <Button layoutX="500.0"
            layoutY="420.0"
            prefWidth="150.0"
            text="Back"
            onAction="#back"/>

</AnchorPane>