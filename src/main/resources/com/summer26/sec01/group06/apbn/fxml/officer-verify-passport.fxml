<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0"
            prefWidth="700.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.OfficerVerifyPassportController">

    <children>

        <Button fx:id="btnBack"
                layoutX="20"
                layoutY="20"
                prefWidth="90"
                text="Back"
                onAction="#goBack"
                style="-fx-background-color:red; -fx-text-fill:white; -fx-font-weight:bold;"/>

        <Label layoutX="220"
               layoutY="25"
               text="Passport Verification"
               textFill="#15417d">

            <font>
                <Font name="System Bold" size="24"/>
            </font>

        </Label>

        <Label layoutX="70"
               layoutY="120"
               text="Passport Number :" />

        <TextField fx:id="txtPassport"
                   layoutX="220"
                   layoutY="115"
                   prefWidth="220"
                   promptText="Enter Passport Number"/>

        <Button layoutX="480"
                layoutY="113"
                prefWidth="100"
                prefHeight="30"
                text="Verify"
                onAction="#verifyPassport"
                style="-fx-background-color:#4CAF50; -fx-text-fill:white; -fx-font-weight:bold;"/>

        <Label layoutX="70"
               layoutY="220"
               text="Verification Result :" />

        <Label fx:id="lblResult"
               layoutX="230"
               layoutY="220"
               prefWidth="420"
               wrapText="true"
               text="Not Verified"/>

    </children>

</AnchorPane>