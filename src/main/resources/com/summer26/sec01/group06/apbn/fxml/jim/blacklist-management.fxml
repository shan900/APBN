<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.jim.BlacklistManagementController">

    <top>

        <Label text="BLACKLIST MANAGEMENT"
               BorderPane.alignment="CENTER"
               style="-fx-background-color:#B71C1C;
               -fx-text-fill:white;
               -fx-font-size:24;
               -fx-font-weight:bold;
               -fx-padding:18;
               -fx-max-width:Infinity;
               -fx-alignment:center;"/>

    </top>

    <center>

        <VBox alignment="CENTER" spacing="15">

            <padding>
                <Insets top="30"/>
            </padding>

            <HBox alignment="CENTER" spacing="10">

                <TextField fx:id="txtPassengerId"
                           promptText="Passenger ID"
                           prefWidth="220"/>

                <Button text="Search"
                        onAction="#searchPassenger"/>

            </HBox>

            <TextField fx:id="txtPassengerName"
                       promptText="Passenger Name"
                       prefWidth="320"/>

            <TextField fx:id="txtReason"
                       promptText="Blacklist Reason"
                       prefWidth="320"/>

            <HBox alignment="CENTER" spacing="15">

                <Button text="Add Blacklist"
                        onAction="#addBlacklist"/>

                <Button text="Remove"
                        onAction="#removeBlacklist"/>

            </HBox>

            <ListView fx:id="listBlacklist"
                      prefWidth="600"
                      prefHeight="180"/>

            <HBox alignment="CENTER" spacing="15">

                <Button text="Refresh"
                        onAction="#loadBlacklist"/>

                <Button text="Clear"
                        onAction="#clearData"/>

                <Button text="Back"
                        onAction="#goBack"
                        style="-fx-background-color:red;
                        -fx-text-fill:white;
                        -fx-font-weight:bold;"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>