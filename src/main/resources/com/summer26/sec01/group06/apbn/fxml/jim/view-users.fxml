<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="900.0"
            prefHeight="600.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.jim.ViewUsersController">

    <top>
        <Label text="USER MANAGEMENT"
               BorderPane.alignment="CENTER"
               style="-fx-background-color:#2E7D32;
                      -fx-text-fill:white;
                      -fx-font-size:24;
                      -fx-font-weight:bold;
                      -fx-padding:18;
                      -fx-max-width:Infinity;
                      -fx-alignment:center;"/>
    </top>

    <center>

        <VBox alignment="CENTER" spacing="15">

            <padding>
                <Insets top="20" bottom="20"/>
            </padding>

            <HBox alignment="CENTER" spacing="10">

                <TextField fx:id="txtUserId"
                           promptText="User ID"
                           prefWidth="180"/>

                <Button text="Search"
                        onAction="#searchUser"/>

            </HBox>

            <TextField fx:id="txtUsername"
                       promptText="Username"
                       prefWidth="320"/>

            <PasswordField fx:id="txtPassword"
                           promptText="Password"
                           prefWidth="320"/>

            <ComboBox fx:id="cmbRole"
                      promptText="Role"
                      prefWidth="320"/>

            <HBox alignment="CENTER" spacing="12">

                <Button text="Add User"
                        onAction="#addUser"/>

                <Button text="Update Password"
                        onAction="#updatePassword"/>

                <Button text="Delete User"
                        onAction="#deleteUser"/>

            </HBox>

            <HBox alignment="CENTER" spacing="12">

                <Button text="Clear"
                        onAction="#clearData"/>

                <Button fx:id="btnBack"
                        text="Back"
                        onAction="#goBack"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>