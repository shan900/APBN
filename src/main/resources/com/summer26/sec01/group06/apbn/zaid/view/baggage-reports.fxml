<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.sec01.group06.apbn.zaid.controllers.BaggageReportsController">
   <children>
      <HBox prefHeight="70.0" prefWidth="1200.0" style="-fx-background-color: #0A2E5C;">
         <children>
            <Button fx:id="backButton" alignment="CENTER" mnemonicParsing="false" onAction="#backButton" style="-fx-background-color: #0A2E5C; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold;" text="← Back" />
            <Label text="✈ APBN Airport Security System" textFill="#e8e1e1">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Region prefHeight="200.0" prefWidth="200.0" />
            <Label text="Baggage Reports" textFill="#fffdfd">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <Label layoutX="125.0" layoutY="421.0" text="Report Type" />
      <Label layoutX="117.0" layoutY="357.0" text="Machine Status" />
      <Label layoutX="117.0" layoutY="291.0" text="Scanner Machine" />
      <HBox alignment="CENTER" layoutX="357.0" layoutY="501.0" prefHeight="100.0" prefWidth="292.0" spacing="20.0">
         <children>
            <Button fx:id="monitorButton" mnemonicParsing="false" onAction="#monitorButton" style="-fx-background-color: #02075D; -fx-text-fill: white; -fx-background-radius: 15;" text="Monitor" />
            <Button fx:id="generateButton" mnemonicParsing="false" onAction="#generateButton" style="-fx-background-color: #02075D; -fx-text-fill: white; -fx-background-radius: 20;" text="Genarate" />
            <Button fx:id="saveButton" mnemonicParsing="false" onAction="#saveButton" style="-fx-background-color: #02075D; -fx-text-fill: white; -fx-background-radius: 15;" text="SAVE" />
         </children>
      </HBox>
      <Label layoutX="572.0" layoutY="270.0" text="Report Date" />
      <VBox alignment="CENTER" layoutX="259.0" layoutY="70.0" prefHeight="200.0" prefWidth="517.0">
         <children>
            <Label text="BAGGAGE REPORTS" textFill="#0a1168">
               <font>
                  <Font name="System Bold" size="30.0" />
               </font>
            </Label>
            <Label text="Monitor scanner status and generate inspection reports">
               <font>
                  <Font size="16.0" />
               </font>
               <textFill>
                  <LinearGradient endX="1.0" endY="1.0">
                     <stops>
                        <Stop>
                           <color>
                              <Color red="0.6578947305679321" green="0.19188596308231354" blue="0.19188596308231354" />
                           </color>
                        </Stop>
                        <Stop offset="1.0">
                           <color>
                              <Color red="0.6499999761581421" green="0.19499999284744263" blue="0.19499999284744263" opacity="0.8931297659873962" />
                           </color>
                        </Stop>
                     </stops>
                  </LinearGradient>
               </textFill>
            </Label>
         </children>
      </VBox>
      <ComboBox fx:id="scannerComboBox" layoutX="230.0" layoutY="287.0" prefWidth="150.0" />
      <ComboBox fx:id="machineStatusComboBox" layoutX="230.0" layoutY="353.0" prefWidth="150.0" />
      <ComboBox fx:id="reportTypeComboBox" layoutX="230.0" layoutY="417.0" prefWidth="150.0" />
      <DatePicker fx:id="reportDatePicker" layoutX="602.0" layoutY="287.0" />
      <Label fx:id="statusLabel" layoutX="486.0" layoutY="628.0" />
   </children>
</AnchorPane>
