<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.sec01.group06.apbn.zaid.controllers.CheckpointManagementController">

   <children>


      <!-- HEADER -->

      <HBox prefHeight="55.0" prefWidth="1200.0" style="-fx-background-color:#0A2E5C;" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

         <children>


            <Button fx:id="backButton" onAction="#backButton" prefHeight="35" prefWidth="90" style="-fx-background-color:#1E4E8C;                                -fx-background-radius:18;                                -fx-text-fill:white;                                -fx-font-weight:bold;                                -fx-cursor:hand;" text="← Back" />


            <Label text="✈ APBN Airport Security System" textFill="WHITE">

               <font>
                  <Font name="System Bold" size="22" />
               </font>

            </Label>


            <Region HBox.hgrow="ALWAYS" />


            <Label text="Checkpoint Management" textFill="WHITE">

               <font>
                  <Font name="System Bold" size="18" />
               </font>

            </Label>


         </children>

      </HBox>



      <!-- TITLE -->

      <Label layoutX="390" layoutY="90" text="IMMIGRATION CHECKPOINT MANAGEMENT">

         <font>
            <Font name="System Bold" size="24" />
         </font>

      </Label>




      <!-- CHECKPOINT -->

      <Label layoutX="80" layoutY="170" text="Checkpoint" />


      <ComboBox fx:id="checkpointComboBox" layoutX="220" layoutY="165" prefWidth="220" />




      <!-- STATUS -->

      <Label layoutX="600" layoutY="170" text="Checkpoint Status" />


      <ComboBox fx:id="checkpointStatusComboBox" layoutX="760" layoutY="165" prefWidth="220" />




      <!-- OFFICER -->

      <Label layoutX="80" layoutY="240" text="Officer" />


      <ComboBox fx:id="officerComboBox" layoutX="220" layoutY="235" prefWidth="220" />





      <!-- TABLE -->


      <TableView fx:id="checkpointTable" layoutX="180" layoutY="330" prefHeight="180" prefWidth="700">


         <columns>


            <TableColumn fx:id="checkpointColumn" prefWidth="250" text="Checkpoint" />


            <TableColumn fx:id="officerColumn" prefWidth="250" text="Assigned Officer" />


            <TableColumn fx:id="statusColumn" prefWidth="200" text="Status" />


         </columns>


      </TableView>





      <!-- BUTTONS -->


      <HBox layoutX="230" layoutY="560" spacing="20">


         <children>


            <Button fx:id="viewButton" onAction="#viewCheckpoint" prefWidth="120" text="View" />


            <Button fx:id="assignButton" onAction="#assignOfficer" prefWidth="120" text="Assign" />


            <Button fx:id="updateButton" onAction="#updateCheckpoint" prefWidth="120" text="Update" />


            <Button fx:id="verifyButton" onAction="#verifyCheckpoint" prefWidth="120" text="Verify" />


            <Button fx:id="saveButton" onAction="#saveCheckpoint" prefWidth="120" text="Save" />


         </children>


      </HBox>



      <!-- STATUS MESSAGE -->


      <Label fx:id="statusLabel" layoutX="609.0" layoutY="646.0" style="-fx-font-size:16;                       -fx-font-weight:bold;                       -fx-text-fill:#0A2E5C;" />



   </children>


</AnchorPane>
