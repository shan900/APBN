<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.jim.ManageOfficersController">

    <top>

        <Label text="MANAGE OFFICERS"
               BorderPane.alignment="CENTER"
               style="-fx-background-color:#2E7D32;
                      -fx-text-fill:white;
                      -fx-font-size:24px;
                      -fx-font-weight:bold;
                      -fx-padding:18;
                      -fx-max-width:Infinity;
                      -fx-alignment:center;"/>

    </top>

    <center>

        <VBox alignment="CENTER" spacing="18">

            <padding>
                <Insets top="30" bottom="30" left="30" right="30"/>
            </padding>

            <!-- Search -->

            <HBox alignment="CENTER" spacing="10">

                <TextField fx:id="txtOfficerId"
                           prefWidth="220"
                           promptText="Officer ID"/>

                <Button fx:id="btnSearch"
                        text="Search"
                        prefWidth="100"
                        onAction="#searchOfficer"/>

            </HBox>

            <!-- Name -->

            <TextField fx:id="txtOfficerName"
                       prefWidth="330"
                       promptText="Officer Name"/>

            <!-- Department -->

            <TextField fx:id="txtDepartment"
                       prefWidth="330"
                       promptText="Department"/>

            <!-- Shift -->

            <ComboBox fx:id="cmbShift"
                      prefWidth="330"
                      promptText="Select Shift"/>

            <!-- Status -->

            <ComboBox fx:id="cmbStatus"
                      prefWidth="330"
                      promptText="Select Status"/>

            <!-- CRUD Buttons -->

            <HBox alignment="CENTER" spacing="15">

                <Button fx:id="btnAdd"
                        text="Add"
                        prefWidth="90"
                        onAction="#addOfficer"/>

                <Button fx:id="btnUpdate"
                        text="Update"
                        prefWidth="90"
                        onAction="#updateOfficer"/>

                <Button fx:id="btnDelete"
                        text="Delete"
                        prefWidth="90"
                        onAction="#deleteOfficer"/>

            </HBox>

            <!-- Bottom Buttons -->

            <HBox alignment="CENTER" spacing="15">

                <Button fx:id="btnClear"
                        text="Clear"
                        prefWidth="90"
                        onAction="#clearData"/>

                <Button fx:id="btnBack"
                        text="Back"
                        prefWidth="90"
                        onAction="#goBack"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>