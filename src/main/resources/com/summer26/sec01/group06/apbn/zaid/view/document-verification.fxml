<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color:#F4F6F8;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.sec01.group06.apbn.zaid.controllers.DocumentVerificationController">

   <children>

      <HBox prefHeight="55" prefWidth="1200" style="-fx-background-color:#0A2E5C;" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

         <children>

            <Button fx:id="backButton" onAction="#backButton" prefWidth="90" style="-fx-background-color:#1E4E8C;                                -fx-text-fill:white;                                -fx-font-weight:bold;                                -fx-background-radius:15;" text="← Back" />

            <Label text="✈ APBN Airport Security System" textFill="WHITE">

               <font>
                  <Font size="22" />
               </font>

            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <Label text="Document Verification" textFill="WHITE">

               <font>
                  <Font size="18" />
               </font>

            </Label>

         </children>

      </HBox>

      <Label layoutX="430" layoutY="90" text="DOCUMENT VERIFICATION">

         <font>
            <Font size="28" />
         </font>

      </Label>

      <Label layoutX="120" layoutY="180" text="Passport Number" />

      <TextField fx:id="passportNumberField" layoutX="260" layoutY="175" prefWidth="220" promptText="Enter Passport Number" />

      <Label layoutX="120" layoutY="250" text="Visa Number" />

      <TextField fx:id="visaNumberField" layoutX="260" layoutY="245" prefWidth="220" promptText="Enter Visa Number" />

      <Label layoutX="120" layoutY="320" text="Document Type" />

      <ComboBox fx:id="documentTypeComboBox" layoutX="260" layoutY="315" prefWidth="220" />

      <Label layoutX="650" layoutY="180" text="Expiry Status" />

      <ComboBox fx:id="expiryStatusComboBox" layoutX="790" layoutY="175" prefWidth="220" />

      <Label layoutX="650" layoutY="250" text="Authenticity" />

      <ComboBox fx:id="authenticityComboBox" layoutX="790" layoutY="245" prefWidth="220" />

      <Button fx:id="scanButton" layoutX="350" layoutY="430" onAction="#scanDocument" prefWidth="120" style="-fx-background-color:#1565C0;                        -fx-text-fill:white;                        -fx-font-weight:bold;" text="Scan" />

      <Button fx:id="verifyButton" layoutX="500" layoutY="430" onAction="#verifyDocument" prefWidth="120" style="-fx-background-color:#2E7D32;                        -fx-text-fill:white;                        -fx-font-weight:bold;" text="Verify" />

      <Button fx:id="clearButton" layoutX="650" layoutY="430" onAction="#clearFields" prefWidth="120" style="-fx-background-color:#EF6C00;                        -fx-text-fill:white;                        -fx-font-weight:bold;" text="Clear" />

      <Button fx:id="saveButton" layoutX="800" layoutY="430" onAction="#saveVerification" prefWidth="120" style="-fx-background-color:#6A1B9A;                        -fx-text-fill:white;                        -fx-font-weight:bold;" text="Save" />

      <Label fx:id="statusLabel" alignment="CENTER" layoutX="420" layoutY="560" prefWidth="350" />

   </children>

</AnchorPane>
