<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.sec01.group06.apbn.controller.shan.SearchPassengerController">

    <children>

        <!-- Back Button -->
        <Button fx:id="btnBack" layoutX="20.0" layoutY="20.0" onAction="#goBack" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: red; -fx-font-weight: bold; -fx-text-fill: white;" text="Back" />

        <!-- Title -->
        <Label layoutX="220.0" layoutY="20.0" text="Search Passenger" textFill="#15417d">

            <font>
                <Font name="System Bold" size="24.0" />
            </font>

        </Label>

        <!-- Passenger ID -->

        <Label layoutX="80.0" layoutY="100.0" text="Passenger ID :" />

        <TextField fx:id="txtPassengerId" layoutX="220.0" layoutY="95.0" prefWidth="220.0" promptText="Enter Passenger ID" />

        <!-- Search Button -->

        <Button layoutX="470.0" layoutY="95.0" onAction="#searchPassenger" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #4CAF50; -fx-font-weight: bold; -fx-text-fill: white;" text="Search" />

        <!-- Result -->

        <Label layoutX="80.0" layoutY="180.0" text="Search Result :" />

        <Label fx:id="lblResult" layoutX="220.0" layoutY="180.0" text="No Data" />

        <!-- Passenger Information -->

        <Label layoutX="80.0" layoutY="240.0" text="Name :" />

        <Label fx:id="lblName" layoutX="220.0" layoutY="240.0" text="-" />

        <Label layoutX="80.0" layoutY="275.0" text="Passport :" />

        <Label fx:id="lblPassport" layoutX="220.0" layoutY="275.0" text="-" />

        <Label layoutX="80.0" layoutY="310.0" text="Nationality :" />

        <Label fx:id="lblNationality" layoutX="220.0" layoutY="310.0" text="-" />

        <Label layoutX="80.0" layoutY="345.0" text="Flight No :" />

        <Label fx:id="lblFlight" layoutX="220.0" layoutY="345.0" text="-" />

        <Label layoutX="80.0" layoutY="380.0" text="Gate :" />

        <Label fx:id="lblGate" layoutX="220.0" layoutY="380.0" text="-" />

    </children>

</AnchorPane>
