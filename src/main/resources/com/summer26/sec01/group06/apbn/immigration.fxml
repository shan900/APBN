<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Reflection?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.sec01.group06.apbn.ImmigrationController">
   <children>
      <Label layoutX="387.0" layoutY="37.0" text="IMMIGRATION OFFICER" textOverrun="CENTER_WORD_ELLIPSIS">
         <effect>
            <Reflection />
         </effect>
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Label layoutX="67.0" layoutY="108.0" text="Passenger Name" />
      <Label layoutX="67.0" layoutY="159.0" text="Passport Number" />
      <Label layoutX="67.0" layoutY="268.0" text="Visa Status" />
      <TextField fx:id="passengerNameField" layoutX="209.0" layoutY="104.0" promptText="Passenger Number" />
      <TextField fx:id="passportField" layoutX="209.0" layoutY="155.0" promptText="Passport Number" />
      <ComboBox fx:id="visaStatusCombo" layoutX="209.0" layoutY="264.0" prefWidth="150.0" />
      <Button fx:id="verifyButton" layoutX="125.0" layoutY="374.0" mnemonicParsing="false" onAction="#verifyButton" style="-fx-background-color: red; -fx-text-fill: white; -fx-font-weight: bold;" text="Verify Passenger" />
      <Button fx:id="approveButton" layoutX="297.0" layoutY="374.0" mnemonicParsing="false" onAction="#approveButton" text="Approve" />
      <Button fx:id="rejectButton" layoutX="440.0" layoutY="374.0" mnemonicParsing="false" onAction="#rejectButton" text="Reject" />
      <Button fx:id="clearButton" layoutX="573.0" layoutY="374.0" mnemonicParsing="false" onAction="#clearButton" text="Clear" />
      <Label fx:id="statusLabel" layoutX="432.0" layoutY="524.0" text="Status Label" />
      <Label layoutX="67.0" layoutY="210.0" text="Passport Search" />
      <TextField fx:id="searchPassportField" layoutX="209.0" layoutY="206.0" promptText="Enter Passport Number" />
      <Button fx:id="searchButton" layoutX="398.0" layoutY="206.0" mnemonicParsing="false" onAction="#searchButton" text="Search" />
      <Button fx:id="saveButton" layoutX="711.0" layoutY="374.0" mnemonicParsing="false" onAction="#saveButton" text="Save Record" />
   </children>
</AnchorPane>
