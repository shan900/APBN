<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.sec01.group06.apbn.controller.EmergencyNotificationsController"
            style="-fx-background-color:#f4f6f9;">

    <Label layoutX="230.0"
           layoutY="25.0"
           text="Emergency Notifications"
           style="-fx-font-size:28px; -fx-font-weight:bold;" />

    <Label layoutX="70.0"
           layoutY="90.0"
           text="Current Notifications"
           style="-fx-font-size:18px; -fx-font-weight:bold;" />

    <Label fx:id="lblNotification"
           layoutX="70.0"
           layoutY="130.0"
           prefWidth="700.0"
           prefHeight="220.0"
           style="-fx-font-size:16px;"/>

    <Button layoutX="250.0"
            layoutY="430.0"
            prefWidth="150.0"
            text="Refresh"
            onAction="#refreshNotifications"/>

    <Button layoutX="500.0"
            layoutY="430.0"
            prefWidth="150.0"
            text="Back"
            onAction="#back"/>

</AnchorPane>