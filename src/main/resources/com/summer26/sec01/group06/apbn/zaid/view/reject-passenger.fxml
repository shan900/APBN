<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color:#F4F7FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.sec01.group06.apbn.zaid.controllers.RejectPassengerController">

   <children>

      <!-- Header -->

      <HBox prefHeight="55" prefWidth="1200" style="-fx-background-color:#0A2E5C;" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

         <children>

            <Button fx:id="backButton" onAction="#backButton" prefHeight="35" prefWidth="90" style="-fx-background-color:#1E4E8C;                                -fx-background-radius:18;                                -fx-text-fill:white;                                -fx-font-weight:bold;" text="← Back" />

            <Label text="✈ APBN Airport Security System" textFill="WHITE">

               <font>
                  <Font size="22" />
               </font>

            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <Label text="Reject Passenger" textFill="WHITE">

               <font>
                  <Font size="18" />
               </font>

            </Label>

         </children>

      </HBox>

      <!-- Title -->

      <Label layoutX="395" layoutY="95" text="REJECT SUSPICIOUS PASSENGER">

         <font>
            <Font size="28" />
         </font>

      </Label>

      <!-- Passport -->

      <Label layoutX="120" layoutY="180" text="Passport Number" />

      <TextField fx:id="passportNumberField" layoutX="270" layoutY="175" prefWidth="250" promptText="Enter Passport Number" />

      <!-- Passenger -->

      <Label layoutX="120" layoutY="250" text="Passenger Name" />

      <TextField fx:id="passengerNameField" layoutX="270" layoutY="245" prefWidth="250" promptText="Passenger Name" />

      <!-- Reason -->

      <Label layoutX="120" layoutY="330" text="Rejection Reason" />

      <TextArea fx:id="reasonArea" layoutX="270" layoutY="325" prefHeight="170" prefWidth="430" promptText="Write rejection reason here..." />

      <!-- Buttons -->

      <HBox layoutX="245" layoutY="545" spacing="20">

         <children>

            <Button fx:id="rejectButton" onAction="#rejectPassenger" prefWidth="120" style="-fx-background-color:#C62828;                                -fx-text-fill:white;                                -fx-font-weight:bold;" text="Reject" />

            <Button fx:id="notifyButton" onAction="#notifySecurity" prefWidth="120" style="-fx-background-color:#EF6C00;                                -fx-text-fill:white;                                -fx-font-weight:bold;" text="Notify" />

            <Button fx:id="blacklistButton" onAction="#blacklistPassenger" prefWidth="120" style="-fx-background-color:#1565C0;                                -fx-text-fill:white;                                -fx-font-weight:bold;" text="Blacklist" />

            <Button fx:id="reportButton" onAction="#generateReport" prefWidth="150" style="-fx-background-color:#2E7D32;                                -fx-text-fill:white;                                -fx-font-weight:bold;" text="Generate Report" />

         </children>

      </HBox>

      <!-- Status -->

      <Label fx:id="statusLabel" alignment="CENTER" layoutX="360" layoutY="635" prefWidth="500" style="-fx-font-size:16;                       -fx-font-weight:bold;                       -fx-text-fill:#0A2E5C;" />

   </children>

</AnchorPane>
